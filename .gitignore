node_modules/
dist/
# Every env file EXCEPT the two that are deliberately shared.
#
# .gitignore listed only .env.local, so .env.production was tracked. It happens
# to hold nothing but VITE_API_URL — a public URL — but the gap is the problem:
# the next env file anyone adds would have been committed by default.
#
# .env.production stays tracked on purpose: it contains no secret, and a fresh
# clone needs it to produce a working production build.
.env
.env.*
!.env.example
!.env.production
frontend.log
*.log

# ─── Secrets — never commit (added by security audit) ───────────────────
# Blocks accidental commits of credentials to this repo. Public repos are
# world-readable, so a single slip here is a real leak. Config that is
# already tracked is unaffected — .gitignore only blocks untracked files.
.env
.env.*
!.env.example
*.p8
*.pem
*.jks
*.keystore
*.key
key.properties
google-services.json
GoogleService-Info.plist
*serviceaccount*.json
*-adminsdk-*.json
.appstoreconnect/
